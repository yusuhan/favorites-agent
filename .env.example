# 复制成 .env.local 再填。真实的 key 不要提交到仓库。

# Supabase：项目 Settings -> API 里的 Project URL 和 anon public key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# DeepSeek：https://platform.deepseek.com 的 API Keys，用来生成行动卡和回答问题
DEEPSEEK_API_KEY=

# 阿里云百炼：https://bailian.console.aliyun.com 的 API Key，用来算向量（通义 text-embedding-v3）
DASHSCOPE_API_KEY=

# ---- 以下只有每周回顾邮件需要 ----

# Supabase：Settings -> API 里的 service_role key。只在服务端定时任务里用，千万不要加 NEXT_PUBLIC_ 前缀
SUPABASE_SERVICE_ROLE_KEY=

# 随便生成一串长随机字符，Vercel 定时任务调用时会带上它
CRON_SECRET=

# Resend：https://resend.com 的 API Key，以及在 Resend 里验证过的发件地址，如 收藏夹 Agent <hi@你的域名>
RESEND_API_KEY=
MAIL_FROM=

# 网站地址，邮件里的回链用，如 https://你的域名
APP_URL=
