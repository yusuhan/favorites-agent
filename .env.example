# 复制成 .env.local 再填。真实的 key 不要提交到仓库。

# Supabase：项目 Settings -> API 里的 Project URL 和 anon public key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# DeepSeek：https://platform.deepseek.com 的 API Keys，用来生成行动卡和回答问题
DEEPSEEK_API_KEY=

# 阿里云百炼：https://bailian.console.aliyun.com 的 API Key，用来算向量（通义 text-embedding-v3）
DASHSCOPE_API_KEY=
